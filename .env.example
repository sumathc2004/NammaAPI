# Copy to .env.local for local development, and set the same variables in your hosting provider.

# Public origin of the site, used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
# On Vercel this falls back to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form (app/api/contact/route.ts) — sends inquiries through Resend.
RESEND_API_KEY=
CONTACT_EMAIL_TO=sales@example.com
# Optional; must be an address on a domain verified in Resend.
CONTACT_EMAIL_FROM="NammaAPI Website <noreply@example.com>"

# Phone + OTP login and dashboard reports — base URL of the AEPS API, no trailing slash.
AEPS_API_BASE_URL=https://nammapayments.in/v5bc/api/aeps

# Transfer reports — base URL of the vendor's client API, no trailing slash.
CLIENT_API_BASE_URL=https://nammapayments.in/apiclient/api

# Encrypts the login session cookie that holds the account credentials server-side.
# Required. Use a different value per environment and never commit it. Generate with: openssl rand -hex 32
AUTH_SECRET=
